API_BASE_URL=http://localhost:8000/api/v1

# Post-property page's drop-pin location picker. Must be prefixed
# NEXT_PUBLIC_ — it's loaded client-side in the browser (Maps JS API keys
# are meant to be restricted by HTTP referrer in Google Cloud Console,
# not kept secret, unlike API_BASE_URL above).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
